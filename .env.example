# ── LLM Provider (OpenRouter) ──────────────────────────────────────
# Required for agentic mode (two-pass LLM-guided file selection).
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model used for agentic file selection and feature triage.
# Any OpenRouter-supported model works; fast/cheap models recommended.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ── Repo Map Model ────────────────────────────────────────────────
# Model name passed to Aider for token counting and budget calculation.
# This does NOT make API calls — it only determines tokenizer and limits.
REPO_MAP_MODEL=gpt-4o-mini
